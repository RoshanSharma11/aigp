{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Layer",
    "description": "Agent-facing capability discovery and execution interface.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://example.com"
    }
  ],
  "paths": {
    "/agent/capabilities": {
      "get": {
        "operationId": "listCapabilities",
        "summary": "List approved capabilities",
        "description": "Returns a summary of approved capabilities available to agents.",
        "responses": {
          "200": {
            "description": "Approved capability summaries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "category": {
                        "type": "string"
                      },
                      "defaultOperation": {
                        "type": "string"
                      },
                      "requiresAuth": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id",
                      "name",
                      "description",
                      "category",
                      "defaultOperation",
                      "requiresAuth"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/agent/capabilities/account_access": {
      "get": {
        "operationId": "get_account_access",
        "summary": "Get Account Access",
        "description": "Authenticate users and establish sessions",
        "tags": [
          "auth"
        ],
        "responses": {
          "200": {
            "description": "Full capability definition",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "execute_account_access",
        "summary": "Execute Account Access",
        "description": "Authenticate users and establish sessions",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "description": "Capability operation to execute.",
                    "enum": [
                      "login"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "password": {
                        "type": "string",
                        "minLength": 8
                      }
                    },
                    "required": [
                      "email",
                      "password"
                    ]
                  }
                },
                "required": [
                  "input"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured capability execution response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "capabilityId": {
                      "type": "string"
                    },
                    "operation": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "data": {},
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "executedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "capabilityId",
                    "operation",
                    "success"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/agent/capabilities/cart_management": {
      "get": {
        "operationId": "get_cart_management",
        "summary": "Get Cart Management",
        "description": "View and modify the shopping cart",
        "tags": [
          "cart"
        ],
        "responses": {
          "200": {
            "description": "Full capability definition",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "execute_cart_management",
        "summary": "Execute Cart Management",
        "description": "View and modify the shopping cart",
        "tags": [
          "cart"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "description": "Capability operation to execute.",
                    "enum": [
                      "add_cart_item",
                      "get_cart",
                      "update_cart_item"
                    ]
                  },
                  "input": {
                    "type": "object"
                  }
                },
                "required": [
                  "input"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured capability execution response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "capabilityId": {
                      "type": "string"
                    },
                    "operation": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "data": {},
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "executedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "capabilityId",
                    "operation",
                    "success"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/agent/capabilities/product_catalog": {
      "get": {
        "operationId": "get_product_catalog",
        "summary": "Get Product Catalog",
        "description": "Browse and search products in the store catalog",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "Full capability definition",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "execute_product_catalog",
        "summary": "Execute Product Catalog",
        "description": "Browse and search products in the store catalog",
        "tags": [
          "catalog"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "description": "Capability operation to execute.",
                    "enum": [
                      "get_product",
                      "list_products",
                      "search_products"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "properties": {
                      "productId": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "productId"
                    ]
                  }
                },
                "required": [
                  "input"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured capability execution response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "capabilityId": {
                      "type": "string"
                    },
                    "operation": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "data": {},
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "executedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "capabilityId",
                    "operation",
                    "success"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
