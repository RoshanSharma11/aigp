{
  "name": "@agent-layer/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-layer": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format esm,cjs --dts",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-layer/core": "workspace:*",
    "ts-morph": "^26.0.0"
  }
}
